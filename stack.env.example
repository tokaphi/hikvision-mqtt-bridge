# À renommer en stack.env et coller dans l'onglet "Environment variables" de
# ton stack Portainer (ou fournir en tant que fichier via env_file).

# Liste des portiers, en JSON sur une seule ligne. Champs disponibles :
# name, ip, port (def. 8000), username, password, type ("outdoor" ou "indoor"),
# num_relays (def. 2), relay_pulse (ex: {"1":3,"2":8}, optionnel).
DOORBELLS=[{"name":"Portier-Ext","ip":"192.168.0.70","username":"admin","password":"xxx","type":"outdoor","relay_pulse":{"1":3,"2":5}},{"name":"Portier-garage","ip":"192.168.0.71","username":"admin","password":"xxx","type":"outdoor","relay_pulse":{"1":3,"2":8}},{"name":"Portier-Int","ip":"192.168.0.72","username":"admin","password":"xxx","type":"indoor"}]

# Connexion au broker MQTT
MQTT__HOST=192.168.0.17
MQTT__PORT=1883
MQTT__USERNAME=mqtt_user
MQTT__PASSWORD=mqtt_password

# Optionnel (valeurs par défaut indiquées)
ROOT_TOPIC=hmd
DEFAULT_PULSE_SECONDS=3
CALL_STATE_POLL_SECONDS=5
RING_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
